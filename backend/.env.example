# Copy this file to .env and fill in what you need. Every value below has a
# safe default in app/config.py, so the app runs out of the box with none of
# this set.

# --- Database ---
# Defaults to a local SQLite file (backend/bhura.db) -- fine for a boutique
# catalog. For real scale, point this at PostgreSQL instead (see README.md
# for setup steps) -- genuinely tested end to end, zero code changes needed:
# DATABASE_URL=postgresql://user:password@localhost:5432/bhura
DATABASE_URL=

# --- Admin login (created once, the first time the DB is seeded) ---
BHURA_ADMIN_USERNAME=admin
BHURA_ADMIN_PASSWORD=bhura-admin-2026

# --- WhatsApp ordering number (used as the fallback if not set in Admin > Settings) ---
BHURA_WHATSAPP_NUMBER=9779768785693

# --- SMTP (optional). Leave blank to skip emails -- orders + PDF receipts still
# work fully without this; the receipt is just generated to disk instead of emailed.
# Example for Gmail: host=smtp.gmail.com port=587, user=you@gmail.com,
# password=an App Password (not your normal password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=orders@bhura.example
SMTP_FROM_NAME=BHURA
